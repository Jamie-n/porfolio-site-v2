{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "eslint \"src/**/*.{js,ts,tsx}\" --max-warnings=0",
    "lint-staged:run": "lint-staged",
    "deadcode": "knip",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,json,css,scss,md,yml}\"",
    "format:write": "prettier --write \"src/**/*.{js,ts,tsx,json,css,scss,md,yml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci:install": "cross-env HUSKY=0 npm ci",
    "browsers": "npx browserslist",
    "browsers:update": "npx update-browserslist-db@latest",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "^16.2.4",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "cross-env": "^10.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.11.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{css,scss,md,json,yml}": [
      "prettier --write"
    ]
  },
  "knip": {
    "ignoreDependencies": [
      "@eslint/eslintrc",
      "eslint-config-next",
      "eslint-plugin-react"
    ]
  }
}
